# =============================================================================
# Tekika AI (Project Agency) - バックエンド設定
# このファイルを `.env` としてコピーして使用してください（tekika-ai-backend/ 直下に配置）。
# APIキーなどの秘密情報は、このファイルには記入せず、自分で作成した `.env` に設定してください。
# =============================================================================

# ---- 使用するLLMプロバイダ ----
# 使用するLLMプロバイダを指定します。
# "ollama" / "openai" / "claude" / "gemini" のいずれかを指定してください。
# 未設定・不正値の場合は "ollama"（ローカル・APIキー不要）にフォールバックします。
#
# openai:
#   OpenAI API、またはOpenAI互換API（OpenRouterなど）を使用します。
# claude:
#   Anthropic Claude APIを使用します。
# gemini:
#   Google Gemini APIを使用します。
# ollama:
#   PC上で動作するOllamaを使用します。APIキーは不要です。

LLM_PROVIDER=ollama

# OpenAI / Claude / Gemini 共通の既定サンプリング温度（0.0〜1.0程度）
# 値が高いほど出力のランダム性が高くなります。
LLM_TEMPERATURE=0.7

# -----------------------------------------------------------------------------
# Ollama（ローカルLLM・APIキー不要）
# -----------------------------------------------------------------------------
# OllamaのAPIサーバーURLです。通常は変更する必要はありません。
OLLAMA_BASE_URL=http://localhost:11434

# Ollamaで使用するデフォルトモデルです。
# 例: qwen2.5:latest
OLLAMA_DEFAULT_MODEL=qwen2.5:latest

# Ollama使用時のサンプリング温度です。
OLLAMA_TEMPERATURE=0.7

# Ollamaへのリクエストタイムアウト（秒）です。
# コメントアウト（#）することでタイムアウトを無制限にできます。
# OLLAMA_REQUEST_TIMEOUT=

# Tool Callingを1回のユーザー要求で繰り返せる最大回数です。
OLLAMA_MAX_TOOL_ITERATIONS=8

# -----------------------------------------------------------------------------
# OpenAI（LLM_PROVIDER=openai を使う場合のみ必須）
# -----------------------------------------------------------------------------
# OpenAI APIキーを設定します。
# APIキー取得: https://platform.openai.com/api-keys
#
# OpenRouterなどのOpenAI互換APIを使用する場合も、この項目にAPIキーを設定します。
OPENAI_API_KEY=

# OpenAI互換APIで使用するデフォルトモデルです。
# OpenAIを直接使用する場合の例: gpt-4o-mini
# OpenRouterなどを使用する場合は、各サービスのモデルIDを指定します。
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# OpenAI互換APIのエンドポイントを変更する場合に指定します。
# OpenAIを直接使用する場合は通常、空欄または未設定で構いません。
# OpenRouterを使用する場合の例:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_BASE_URL=

# OpenAI互換APIへのリクエストタイムアウト（秒）です。
# コメントアウト（#）することでデフォルト設定を使用します。
# OPENAI_REQUEST_TIMEOUT=

# -----------------------------------------------------------------------------
# Anthropic Claude（LLM_PROVIDER=claude を使う場合のみ必須）
# -----------------------------------------------------------------------------
# Anthropic APIキーを設定します。
# APIキー取得: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Claudeで使用するデフォルトモデルです。
CLAUDE_DEFAULT_MODEL=claude-sonnet-4-5

# Anthropic APIへのリクエストタイムアウト（秒）です。
# ANTHROPIC_REQUEST_TIMEOUT=

# -----------------------------------------------------------------------------
# Google Gemini（LLM_PROVIDER=gemini を使う場合のみ必須）
# -----------------------------------------------------------------------------
# Google Gemini APIキーを設定します。
# APIキー取得: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=

# Geminiで使用するデフォルトモデルです。
GEMINI_DEFAULT_MODEL=gemini-3.6-flash

# Gemini APIへのリクエストタイムアウト（秒）です。
# GEMINI_REQUEST_TIMEOUT=

# -----------------------------------------------------------------------------
# エージェント動作モード
# -----------------------------------------------------------------------------
# QUALITY:
#   Tool Callingを含むエージェントの処理ループを使用します。
# SPEED:
#   Tool Callingループを使わず、単発の応答を優先します。
AGENT_MODE=QUALITY

# -----------------------------------------------------------------------------
# ローカル画像生成（Stable Diffusion WebUI）
# -----------------------------------------------------------------------------
# Stable Diffusion WebUI（AUTOMATIC1111など）のAPIエンドポイントです。
# WebUIを使用しない場合でも、この設定は通常そのままで構いません。
SD_WEBUI_BASE_URL=http://localhost:7860

# -----------------------------------------------------------------------------
# サーバー設定
# -----------------------------------------------------------------------------
# FastAPIバックエンドが待ち受けるホストです。
# 127.0.0.1の場合、このPC自身からのみアクセスできます。
HOST=127.0.0.1

# FastAPIバックエンドのポート番号です。
PORT=8000

# デバッグモードです。
# 本番運用では通常 false にします。
DEBUG=false
